# Builds the plugin's gait table from animation_bounce.csv (summarise_animations.awk).
#
#   awk -F, -v mode=csv    -f make_gait_table.awk animation_bounce.csv > data/mech_gait.csv
#   awk -F, -v mode=header -f make_gait_table.awk data/mech_gait.csv   > src/GaitTable.hpp
#
# mech_gait.csv is the reviewable table; GaitTable.hpp compiles it into the plugin.
# A file of the same format named mw5_mech_gait.csv in the UEVR profile folder
# overrides or adds chassis at run time.
BEGIN { OFS = "," }
{ sub(/\r$/, "") }
mode == "csv" {
    if (FNR == 1) {
        for (i = 1; i <= NF; i++) column[$i] = i
        print "Chassis,WalkBounceCm,RunBounceCm,WalkCycleS,RunCycleS,StepsPerCycle,WalkSpeedKmh,RunSpeedKmh"
        next
    }
    if ($column["WalkSpeedKmh"] == "" || $column["RunBounceCm"] == "") next
    rows[$1] = $1 OFS $column["WalkBounceCm"] OFS $column["RunBounceCm"] OFS $column["WalkCycleS"] OFS $column["RunCycleS"] OFS \
               $column["RunSteps"] OFS $column["WalkSpeedKmh"] OFS $column["RunSpeedKmh"]
    names[++count] = $1
}
mode == "header" && FNR > 1 && NF >= 8 {
    lines[++count] = sprintf("    {\"%s\", %sf, %sf, %sf, %sf, %d, %sf, %sf},", $1, $2, $3, $4, $5, $6, $7, $8)
}
END {
    if (mode == "csv") {
        # Sorted by name so the file diffs cleanly when it is regenerated.
        for (i = 1; i <= count; i++) for (j = i + 1; j <= count; j++)
            if (tolower(names[j]) < tolower(names[i])) { t = names[i]; names[i] = names[j]; names[j] = t }
        for (i = 1; i <= count; i++) print rows[names[i]]
    } else {
        print "#pragma once"
        print "// Generated by tools/make_gait_table.awk from data/mech_gait.csv. Do not edit."
        print "// Pelvis travel per step and cycle timing of each chassis's first-person walk"
        print "// and run animations, and the speeds at which the game plays them."
        print "namespace mw5 {"
        print "struct GaitRow {"
        print "    const char* chassis;"
        print "    float walkBounceCm, runBounceCm, walkCycleS, runCycleS;"
        print "    int stepsPerCycle;"
        print "    float walkSpeedKmh, runSpeedKmh;"
        print "};"
        print "inline constexpr GaitRow kGaitTable[] = {"
        for (i = 1; i <= count; i++) print lines[i]
        print "};"
        print "}"
    }
}
